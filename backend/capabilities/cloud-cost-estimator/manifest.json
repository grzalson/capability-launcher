{
  "id": "cloud-cost-estimator", "name": "Cloud Cost Estimator",
  "description": "Explore a simulated monthly infrastructure budget. Compare regions and spot pricing before committing resources.",
  "author": "Cloud Infrastructure", "version": "1.3.0", "category": "Infrastructure",
  "timeout_seconds": 10, "python_dependencies": [], "output_type": "table",
  "input_schema": {"type": "object", "additionalProperties": false, "required": ["region", "instance_count", "spot", "environment"], "properties": {
    "region": {"type": "string", "title": "Cloud region", "enum": ["eu-central-1", "us-east-1", "ap-southeast-1"], "default": "eu-central-1"},
    "instance_count": {"type": "integer", "title": "Instance count", "minimum": 1, "maximum": 100, "default": 6, "description": "Simulated general-purpose instances, 730 hours per month."},
    "spot": {"type": "boolean", "title": "Use spot instances", "description": "Apply a simulated 65% compute discount.", "default": false},
    "environment": {"type": "string", "title": "Environment tag", "minLength": 1, "maxLength": 40, "default": "staging"}
  }}
}
